{
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "target": "ES2020",
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@design-system/button": ["packages/button/src/index.ts"],
      "@design-system/layers": ["packages/layers/src/index.ts"],
      "@design-system/modal": ["packages/modal/src/index.ts"],
      "@design-system/dropdown": ["packages/dropdown/src/index.ts"],
      "@design-system/icons": ["packages/icons/src/index.ts"],
      "@design-system/input": ["packages/input/src/index.ts"],
      "@design-system/icon-button": ["packages/icon-button/src/index.ts"],
      "@design-system/image": ["packages/image/src/index.ts"],
      "@design-system/list": ["packages/list/src/index.ts"],
      "@design-system/theme": ["packages/theme/src/index.ts"],
      "@design-system/typography": ["packages/typography/src/index.ts"],
      "@design-system/tabs": ["packages/tabs/src/index.ts"],
      "@design-system/accordion": ["packages/accordion/src/index.ts"],
      "@design-system/label": ["packages/label/src/index.ts"],
      "@design-system/link": ["packages/link/src/index.ts"],
      "@design-system/product-card": ["packages/product-card/src/index.ts"],
      "@design-system/tooltip": ["packages/tooltip/src/index.ts"],
      "@design-system/product-grid": ["packages/product-grid/src/index.ts"],
      "@design-system/carousel": ["packages/carousel/src/index.ts"],
      "@design-system/footer": ["packages/footer/src/index.ts"]
    }
  }
}
