{
  "name": "@design-system/storybook",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/storybook",
  "targets": {
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "storybook dev -p 6006",
        "cwd": "apps/storybook"
      }
    },
    "build-storybook": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{workspaceRoot}/apps/storybook/storybook-static"],
      "options": {
        "command": "storybook build -o storybook-static",
        "cwd": "apps/storybook"
      }
    }
  }
}
